FROM docker.io/gentoo/stage3:amd64-systemd

# Dependencies from ::gentoo use stable keywords, because the official binary
# package host is built from the stable tree; this overlay's own packages are
# ~amd64 only. stage3 already configures that binhost in
# /etc/portage/binrepos.conf. getbinpkg installs a binary package from it
# whenever one matches the requested version, USE flags and dependencies, and
# builds from source when none does. binpkg-request-signature requires a valid
# signature on every binary package, whatever binrepos.conf says: a matching
# package that fails the check fails the install instead of building from
# source. Portage runs getuto to set up the keyring that checks them.
#
# stage3 ships without the Gentoo tree. emerge-webrsync installs the latest
# daily snapshot as a single download, verified against the Gentoo release
# key, instead of rsyncing every file of the tree.
#
# dev-util/claude-code is the Claude Code CLI the workflows run. It installs
# a prebuilt binary, which needs its license accepted and the AVX and AVX2
# CPU flags.
RUN echo 'FEATURES="-pid-sandbox -ipc-sandbox -network-sandbox getbinpkg binpkg-request-signature"' >> /etc/portage/make.conf && \
    mkdir -p /etc/portage/package.accept_keywords /etc/portage/package.license /etc/portage/package.use && \
    echo '*/*::divoxx-overlay ~amd64' > /etc/portage/package.accept_keywords/divoxx-overlay && \
    echo 'dev-util/claude-code all-rights-reserved' > /etc/portage/package.license/claude-code && \
    echo 'dev-util/claude-code cpu_flags_x86_avx cpu_flags_x86_avx2' > /etc/portage/package.use/claude-code && \
    emerge-webrsync

# sys-apps/portage is upgraded first and alone, only if an update is pending,
# per Gentoo's own recommendation (wiki.gentoo.org/wiki/Portage): run
# `emerge --oneshot sys-apps/portage` before anything else. Omitting --deep
# keeps resolution shallow to portage's own direct deps (merged ahead of it,
# under the still-old portage) instead of pulling in unrelated @system/@world
# members alongside it, so portage is always last in its own merge list and
# never shares a process with a merge that runs after it self-upgrades.
# A pending update is listed as [ebuild ...], or as [binary ...] when it comes
# from the binhost. The upgrade runs getuto, so the keyring it creates is
# removed before this step ends and no layer of the image holds its private key.
RUN if emerge --pretend --update sys-apps/portage | grep -q -E '^\[(ebuild|binary)'; then \
        emerge --oneshot --update --quiet-build sys-apps/portage && \
        rm -rf /etc/portage/gnupg; \
    else \
        echo "sys-apps/portage is already up to date, skipping"; \
    fi

# Everything else, now guaranteed to run under a current portage. The last
# commands remove what the image doesn't need at runtime: package versions
# nothing depends on, downloaded source tarballs and binary packages, and the
# binary package keyring. getuto generated that keyring's private key during
# this build, so it stays out of the published image; each CI job that
# installs binary packages creates its own.
RUN emerge -u1vDN --quiet-build dev-lang/perl app-admin/perl-cleaner && \
    perl-cleaner --all -- --quiet-build && \
    emerge -uvDN --with-bdeps=y --backtrack=50 --quiet-build @world && \
    emerge --noreplace --quiet-build dev-vcs/git dev-util/pkgdev dev-util/pkgcheck dev-util/github-cli dev-lang/go dev-lang/rust-bin app-misc/jq dev-util/claude-code && \
    emerge --depclean && \
    rm -rf /var/cache/distfiles/* /var/cache/binhost/* /etc/portage/gnupg

# dev-util/claude-code installs claude to /opt/bin, which Gentoo's login PATH
# includes (/etc/env.d/50baselayout) but the container's PATH doesn't.
ENV PATH="${PATH}:/opt/bin"
